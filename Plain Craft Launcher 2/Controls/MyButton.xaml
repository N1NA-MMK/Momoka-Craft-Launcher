<Border x:Class="PCL.MyButton"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FocusVisualStyle="{x:Null}" x:Name="PanBack"
        Focusable="True" UseLayoutRounding="False" SnapsToDevicePixels="False"
        Background="{StaticResource ColorBrushSemiTransparent}">
    <Border CornerRadius="{DynamicResource ShapeCornerButton}" x:Name="PanFore"
            BorderThickness="{DynamicResource ShapeBorderThickness}" BorderBrush="{DynamicResource ColorBrush1}"
            RenderTransformOrigin="0.5,0.5" Background="{DynamicResource ColorBrushHalfWhite}">
        <Border.RenderTransform>
            <ScaleTransform />
        </Border.RenderTransform>
        <Grid>
            <!-- 内容文字 -->
            <TextBlock TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True" TextTrimming="None"
                       HorizontalAlignment="Center" x:Name="LabText" VerticalAlignment="Center"
                       RenderTransformOrigin="0.5,0.5"
                       Foreground="{Binding Parent.BorderBrush, RelativeSource={RelativeSource Self}}"
                       FontSize="{DynamicResource ShapeFontSizeBody}"
                       IsHitTestVisible="False">
                <TextBlock.RenderTransform>
                    <ScaleTransform />
                </TextBlock.RenderTransform>
            </TextBlock>
            <!-- 触控发光层 -->
            <Border x:Name="GlowLayer" CornerRadius="{DynamicResource ShapeCornerButton}" IsHitTestVisible="False" Opacity="0"
                    Background="{DynamicResource LiquidGlassRimLightBrush}" />
        </Grid>
    </Border>
</Border>
